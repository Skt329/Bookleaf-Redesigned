// ============================================================================
// BookLeaf Publishing — Prisma Schema
// All monetary values stored in paise (integer) to avoid floating-point errors
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// Enums
// ============================================================================

enum UserRole {
  CHALLENGER
  AUTHOR
  ADMIN
}

enum PublishingPackageType {
  BASIC
  PREMIUM
  PROFESSIONAL
  WRITING_CHALLENGE
}

enum Genre {
  LITERARY_FICTION
  NON_FICTION
  SELF_HELP
  ROMANCE
  THRILLER
  POETRY
  HISTORICAL_FICTION
  BUSINESS
  TRAVEL
  MEMOIR
  HUMOR
  PARENTING
  CRIME
  CONTEMPORARY_FICTION
  URDU_LITERATURE
  OTHER
}

enum BookStatus {
  MANUSCRIPT_RECEIVED
  EDITING
  COVER_DESIGN
  TYPESETTING
  PROOFREADING
  ISBN_ASSIGNMENT
  PRINTING
  DISTRIBUTION_SETUP
  PUBLISHED
  WRITING_CHALLENGE_IN_PROGRESS
}

enum PrintPartner {
  IN_HOUSE
  REPRO_INDIA
  EPITOME_BOOKS
}

enum Language {
  ENGLISH
  HINDI
}

enum Platform {
  AMAZON_INDIA
  FLIPKART
  AMAZON_US
  AMAZON_UK
  BOOKLEAF_STORE
}

enum PayoutStatus {
  PENDING
  PAID
  OVERDUE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum BookType {
  PAPERBACK
  EBOOK
}

enum TicketCategory {
  ROYALTY_PAYMENTS
  ISBN_METADATA
  PRINTING_QUALITY
  DISTRIBUTION
  BOOK_STATUS
  GENERAL
}

enum TicketPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketSenderRole {
  AUTHOR
  ADMIN
}

enum NotificationType {
  ROYALTY_SUMMARY
  TICKET_RESPONSE
  BOOK_STATUS_UPDATE
  GENERAL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum ChallengeStatus {
  ACTIVE
  PAUSED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

enum ReviewSource {
  GOOGLE
  VIDEO
  INTERNAL
}

enum PackageName {
  BASIC
  PREMIUM
  PROFESSIONAL
}

// ============================================================================
// NextAuth.js Required Models (Prisma Adapter)
// ============================================================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================================
// Core Business Models
// ============================================================================

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  password         String?
  name             String?
  phone            String?
  city             String?
  role             UserRole @default(CHALLENGER)
  avatarUrl        String?
  bio              String?  @db.Text
  joinedDate       DateTime @default(now())
  isVerified       Boolean  @default(false)
  stripeCustomerId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // NextAuth relations
  accounts Account[]
  sessions Session[]

  // Business relations
  author                      Author?
  orders                      Order[]
  cart                        Cart?
  assignedTickets             SupportTicket[]            @relation("AssignedAdmin")
  ticketMessages              TicketMessage[]
  triggeredNotifications      NotificationLog[]          @relation("TriggeredByAdmin")
  writingChallengeRegistrations WritingChallengeRegistration[]

  @@map("users")
}

model Author {
  id                  String               @id @default(cuid())
  userId              String               @unique
  authorId            String               @unique // e.g. AUTH001
  penName             String?
  authorBio           String?              @db.Text
  socialLinks         Json?
  bankAccountDetails  Json?                // encrypted at application layer
  publishingPackage   PublishingPackageType?
  totalRoyaltyEarned  Int                  @default(0) // paise
  totalRoyaltyPaid    Int                  @default(0) // paise
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  books                  Book[]
  royaltyRecords         RoyaltyRecord[]
  supportTickets         SupportTicket[]
  notificationLogs       NotificationLog[]
  packagePurchases       PackagePurchase[]
  challengeRegistrations WritingChallengeRegistration[]

  @@map("authors")
}

model Book {
  id                    String       @id @default(cuid())
  bookId                String       @unique // e.g. BK001
  authorId              String
  title                 String
  isbn                  String?
  genre                 Genre
  description           String?      @db.Text
  coverImageUrl         String?
  publicationDate       DateTime?
  status                BookStatus   @default(MANUSCRIPT_RECEIVED)
  mrp                   Int?         // paise
  authorRoyaltyPerCopy  Int?         // paise
  printPartner          PrintPartner?
  language              Language     @default(ENGLISH)
  pageCount             Int?
  isEbookAvailable      Boolean      @default(false)
  isPaperbackAvailable  Boolean      @default(false)
  isFeatured            Boolean      @default(false)
  writingChallengeId    String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  author            Author                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  writingChallenge   WritingChallenge?     @relation(fields: [writingChallengeId], references: [id], onDelete: SetNull)
  platformListings  BookPlatformListing[]
  royaltyRecords    RoyaltyRecord[]
  salesRecords      SalesRecord[]
  orderItems        OrderItem[]
  supportTickets    SupportTicket[]

  @@index([authorId])
  @@index([status])
  @@index([genre])
  @@index([createdAt])
  @@map("books")
}

model BookPlatformListing {
  id          String   @id @default(cuid())
  bookId      String
  platform    Platform
  externalUrl String?
  isActive    Boolean  @default(true)

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@map("book_platform_listings")
}

model RoyaltyRecord {
  id                     String       @id @default(cuid())
  bookId                 String
  authorId               String
  quarter                String       // e.g. Q3-2025
  copiesSoldThisQuarter  Int
  grossRoyalty            Int          // paise
  royaltyPaid            Int          // paise
  royaltyPending         Int          // paise
  payoutDate             DateTime?
  payoutStatus           PayoutStatus @default(PENDING)
  createdAt              DateTime     @default(now())

  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  author Author @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@map("royalty_records")
}

model SalesRecord {
  id         String   @id @default(cuid())
  bookId     String
  platform   Platform
  copiesSold Int
  saleDate   DateTime
  revenue    Int      // paise
  createdAt  DateTime @default(now())

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId])
  @@map("sales_records")
}

model Order {
  id                    String      @id @default(cuid())
  orderNumber           String      @unique // e.g. BL-2025-001234
  customerId            String?     // null for guest checkout
  guestEmail            String?     // for guest order tracking
  guestName             String?     // guest buyer name
  guestPhone            String?     // guest contact phone
  status                OrderStatus @default(PENDING)
  totalAmount           Int         // paise
  shippingAddress       Json?
  stripePaymentIntentId String?
  stripePaymentStatus   String?
  trackingNumber        String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  customer User?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    OrderItem[]

  @@index([customerId])
  @@index([guestEmail])
  @@map("orders")
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  bookId    String
  quantity  Int
  unitPrice Int      // paise
  bookType  BookType

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  book  Book  @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model Cart {
  id        String   @id @default(cuid())
  userId    String?  @unique
  sessionId String?
  items     Json     @default("[]")
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("carts")
}

model SupportTicket {
  id                  String          @id @default(cuid())
  ticketNumber        String          @unique // e.g. TKT-2025-0042
  authorId            String
  bookId              String?
  subject             String
  description         String          @db.Text
  category            TicketCategory
  aiSuggestedCategory TicketCategory?
  priority            TicketPriority  @default(MEDIUM)
  aiSuggestedPriority TicketPriority?
  status              TicketStatus    @default(OPEN)
  assignedAdminId     String?
  aiDraftResponse     String?         @db.Text
  attachmentUrls      Json?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  author        Author          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  book          Book?           @relation(fields: [bookId], references: [id], onDelete: SetNull)
  assignedAdmin User?           @relation("AssignedAdmin", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  messages      TicketMessage[]

  @@index([authorId])
  @@map("support_tickets")
}

model TicketMessage {
  id             String           @id @default(cuid())
  ticketId       String
  senderId       String
  senderRole     TicketSenderRole
  content        String           @db.Text
  isInternalNote Boolean          @default(false)
  createdAt      DateTime         @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender User          @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@map("ticket_messages")
}

model NotificationLog {
  id                 String             @id @default(cuid())
  authorId           String
  notificationType   NotificationType
  subject            String
  emailBody          String             @db.Text
  status             NotificationStatus @default(PENDING)
  sentAt             DateTime?
  errorMessage       String?            @db.Text
  triggeredByAdminId String?

  author           Author @relation(fields: [authorId], references: [id], onDelete: Cascade)
  triggeredByAdmin User?  @relation("TriggeredByAdmin", fields: [triggeredByAdminId], references: [id], onDelete: SetNull)

  @@map("notification_logs")
}

// ============================================================================
// Writing Challenge Models
// ============================================================================

model WritingChallenge {
  id            String          @id @default(cuid())
  title         String
  price         Int             // paise
  originalPrice Int             // paise
  durationDays  Int             @default(21)
  status        ChallengeStatus @default(ACTIVE)
  description   String?         @db.Text
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  registrations WritingChallengeRegistration[]
  books         Book[]

  @@map("writing_challenges")
}

model WritingChallengeRegistration {
  id                    String        @id @default(cuid())
  challengeId           String
  userId                String        // FK to User (CHALLENGER or AUTHOR)
  authorId              String?       // FK to Author (only if user is already AUTHOR)
  paymentStatus         PaymentStatus @default(PENDING)
  stripePaymentIntentId String?
  stripeSessionId       String?       // Stripe Checkout session ID
  registeredAt          DateTime      @default(now())
  personalStartDate     DateTime?     // Set when payment confirmed — start of 21-day window
  personalEndDate       DateTime?     // personalStartDate + 21 days
  completedChallenge    Boolean       @default(false)
  bookPublished         Boolean       @default(false)
  gracePeriodEnds       DateTime?

  challenge  WritingChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  author     Author?          @relation(fields: [authorId], references: [id], onDelete: SetNull)
  dailyPoems DailyPoem[]

  @@index([userId])
  @@index([challengeId])
  @@map("writing_challenge_registrations")
}

model DailyPoem {
  id               String    @id @default(cuid())
  registrationId   String
  dayNumber        Int
  title            String
  content          Json?     // Tiptap JSON structure
  wordCount        Int       @default(0)
  aiFeedback       String?   @db.Text
  aiSuggestions    String?   @db.Text
  submittedAt      DateTime?
  lastSavedAt      DateTime  @default(now())
  isDraft          Boolean   @default(true)

  registration WritingChallengeRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@unique([registrationId, dayNumber])
  @@map("daily_poems")
}

// ============================================================================
// Package & Store Models
// ============================================================================

model PublishingPackage {
  id            String      @id @default(cuid())
  name          PackageName @unique
  price         Int         // paise
  features      Json        // array of feature strings
  stripePriceId String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  purchases PackagePurchase[]

  @@map("publishing_packages")
}

model PackagePurchase {
  id                    String        @id @default(cuid())
  authorId              String
  packageId             String
  stripePaymentIntentId String?
  stripeSessionId       String?
  status                PaymentStatus @default(PENDING)
  purchasedAt           DateTime      @default(now())

  author         Author           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  package        PublishingPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@map("package_purchases")
}

// ============================================================================
// Content Models
// ============================================================================

model BlogPost {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  content       String    @db.Text
  coverImageUrl String?
  authorName    String?
  tags          String[]
  isPublished   Boolean   @default(false)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("blog_posts")
}

model Review {
  id             String       @id @default(cuid())
  authorName     String
  authorImageUrl String?
  bookTitle      String?
  rating         Int
  reviewText     String       @db.Text
  source         ReviewSource
  videoUrl       String?
  isFeatured     Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@map("reviews")
}

// ============================================================================
// Admin Notifications
// ============================================================================

model AdminNotification {
  id          String   @id @default(cuid())
  type        String   // e.g. "CHALLENGE_BOOKS_READY", "NEW_ORDER", "CHALLENGE_COMPLETED"
  title       String
  message     String   @db.Text
  referenceId String?  // Generic FK to challenge/order/etc.
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("admin_notifications")
}
